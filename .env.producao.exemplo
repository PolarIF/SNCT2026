# Configuração do site da SNCT em produção.
#
# Copie este arquivo para ".env", ao lado do docker-compose.yml, e preencha.
# Ele contém senhas: não coloque no git e não mande por grupo de mensagem.

# ---------------------------------------------------------------- domínio
DOMINIO=snctifroari.online
EMAIL_CERTIFICADO=  # e-mail para os avisos do Let's Encrypt (vencimento etc.)

ALLOWED_HOSTS=snctifroari.online,www.snctifroari.online

# ---------------------------------------------------------------- Django
# Gere uma chave nova e única com:
#   docker run --rm python:3.13-slim python -c "import secrets; print(secrets.token_urlsafe(50))"
# Trocar esta chave depois só derruba as sessões abertas; nada se perde.
SECRET_KEY=

DEBUG=0

# Deixe 1. Só coloque 0 se o site precisar rodar em http por algum tempo
# (por exemplo, enquanto o certificado não sai). Com 0, senha e cookie de
# sessão trafegam em texto claro — volte para 1 assim que houver certificado.
HTTPS_ATIVO=1

# ---------------------------------------------------------------- banco
# Senha do PostgreSQL. Qualquer coisa longa e aleatória serve; ela só é usada
# entre os dois containers e nunca aparece para o usuário.
POSTGRES_PASSWORD=

# ------------------------------------------------- primeiro administrador
# OBRIGATÓRIO. A conta é criada na primeira subida e ignorada depois disso.
# Sem ela o site sobe sem nenhum usuário e ninguém consegue entrar, então o
# compose se recusa a subir com ADMIN_SENHA em branco.
# Entre em /admin/ e troque a senha logo na primeira vez.
ADMIN_USUARIO=admin
ADMIN_SENHA=
ADMIN_EMAIL=
