# Copie para .env e ajuste. O .env nunca vai para o git.

# Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-por-uma-chave-gerada

# 1 na sua máquina, 0 (ou ausente) em produção.
DEBUG=1

# Domínios que podem servir a aplicação, separados por vírgula.
# Em produção: snctifroari.online,www.snctifroari.online
ALLOWED_HOSTS=localhost,127.0.0.1

# Sem esta variável o projeto usa SQLite (db.sqlite3), que basta para
# desenvolver. No Railway, ligue o PostgreSQL e use a referência
# ${{ Postgres.DATABASE_URL }}.
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
